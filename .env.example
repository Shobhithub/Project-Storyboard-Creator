# MongoDB Atlas or local MongoDB connection string; never commit a real URI/password.
MONGODB_URI=mongodb://127.0.0.1:27017/vizzy-studio

# Generate a private random value (PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 })) )
JWT_SECRET=replace-this-with-at-least-32-random-characters
NODE_ENV=development
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173

# Text planning/chat. No provider key is included in the repository.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Images: openai (paid API) or comfyui (self-hosted open-source image workflow).
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=docs/comfyui-workflow.example.json
MAX_GENERATION_ALTERNATIVES=3
GENERATION_CONCURRENCY=1

# local is suitable for local development. For production, use Cloudinary.
IMAGE_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
